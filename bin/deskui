#!/bin/bash
#
# deskui - dialog(1) TUI to manage the root desktop-access services
#          (selkies WebSocket + x11vnc) installed by setup-root-desktop-selkies-vnc.sh
#
# Two submenus: selkies / vnc. Each exposes systemctl management; selkies also
# changes the basic-auth login + password and the stream resolution, vnc the
# connection password.
#
# The main menu has two buttons: "Select" activates the highlighted entry,
# "Exit" quits. Submenus have no OK button - press Enter to activate, "Back"
# returns.
#
set -u

# ---- config / discovery ----
BACKTITLE="deskui - selkies + vnc TUI"
SELKIES_UNIT="selkies.service"
VNC_UNIT="x11vnc.service"
DESKTOP_UNIT="xfce-session.service"
SELKIES_WRAPPER="/opt/selkies/start-selkies.sh"
DESKTOP_WRAPPER="/opt/selkies/start-desktop.sh"
VNC_UNIT_FILE="/etc/systemd/system/x11vnc.service"
# VNC password file path is read from the x11vnc unit (-rfbauth ...) so deskui
# follows the build-time DESKTOP_USER (e.g. /home/user/.vnc/passwd), not /root.
VNC_PASSWD=$(grep -oP '(?<=-rfbauth )[^ ]+' "$VNC_UNIT_FILE" 2>/dev/null | head -1)
VNC_PASSWD="${VNC_PASSWD:-/root/.vnc/passwd}"

die() { echo "E: $*" >&2; exit 1; }

DLG() { dialog --backtitle "$BACKTITLE" "$@" 3>&1 1>&2 2>&3; }

# token charset accepted for login / selkies password (avoids sed/systemd/shell quoting traps)
valid_token() { [[ $1 =~ ^[A-Za-z0-9._@%+:-]+$ ]]; }

# ---- generic helpers ----

# run_show TITLE CMD...  -> run a command, show stdout+stderr+exit code in a scrollable textbox
run_show() {
    local title=$1; shift
    local tmp rc
    tmp=$(mktemp /tmp/deskui.XXXXXX)
    { printf '$ %s\n\n' "$*"; } >"$tmp"
    "$@" >>"$tmp" 2>&1; rc=$?
    { printf '\n[exit %s]\n' "$rc"; } >>"$tmp"
    DLG --title "$title" --exit-label "Back" --textbox "$tmp" 22 78
    rm -f "$tmp"
}

# systemctl submenu, shared by both services
systemctl_menu() {
    local unit=$1 ch
    while true; do
        ch=$(DLG --no-ok --cancel-label "Back" --title "systemctl: $unit" --menu "Action:" 16 60 7 \
            status  "Show status" \
            start   "Start" \
            stop    "Stop" \
            restart "Restart" \
            enable  "Enable at boot" \
            disable "Disable at boot" \
            logs    "Show logs (journalctl)") || return
        case $ch in
            status)  run_show "status $unit"  systemctl --no-pager status "$unit" ;;
            start)   run_show "start $unit"   systemctl start "$unit" ;;
            stop)    run_show "stop $unit"    systemctl stop "$unit" ;;
            restart) run_show "restart $unit" systemctl restart "$unit" ;;
            enable)  run_show "enable $unit"  systemctl enable "$unit" ;;
            disable) run_show "disable $unit" systemctl disable "$unit" ;;
            logs)    run_show "logs $unit"    journalctl -u "$unit" -n 120 --no-pager ;;
        esac
    done
}

# ---- selkies: credential management ----

selkies_get_user() { grep -oP '(?<=--basic_auth_user=)[^ ]+' "$SELKIES_WRAPPER" 2>/dev/null | head -1 | tr -d "'"; }

selkies_change_user() {
    local cur new
    cur=$(selkies_get_user)
    new=$(DLG --cancel-label "Back" --title "Selkies login" --inputbox "New login (basic-auth):" 9 60 "${cur:-selkies}") || return
    if ! valid_token "$new"; then
        DLG --title "Error" --msgbox "Invalid login. Allowed chars: A-Z a-z 0-9 . _ @ % + : -" 9 60
        return
    fi
    sed -i "s/--basic_auth_user=[^ ]*/--basic_auth_user='${new}'/" "$SELKIES_WRAPPER" \
        || { DLG --title "Error" --msgbox "Failed to write $SELKIES_WRAPPER" 9 60; return; }
    run_show "restart $SELKIES_UNIT" systemctl restart "$SELKIES_UNIT"
    DLG --title "Selkies login" --msgbox "Login changed to: ${new}\nService restarted." 9 60
}

selkies_change_pass() {
    local new
    new=$(DLG --cancel-label "Back" --insecure --title "Selkies password" --passwordbox "New password (basic-auth):" 9 60) || return
    if ! valid_token "$new"; then
        DLG --title "Error" --msgbox "Invalid password. Allowed chars: A-Z a-z 0-9 . _ @ % + : -" 9 60
        return
    fi
    # password lives in the wrapper as --basic_auth_password='...' (not a unit change, no daemon-reload)
    sed -i "s/--basic_auth_password=[^ ]*/--basic_auth_password='${new}'/" "$SELKIES_WRAPPER" \
        || { DLG --title "Error" --msgbox "Failed to write $SELKIES_WRAPPER" 9 60; return; }
    run_show "restart $SELKIES_UNIT" systemctl restart "$SELKIES_UNIT"
    DLG --title "Selkies password" --msgbox "Password changed.\nService restarted." 9 60
}

selkies_menu() {
    local ch
    while true; do
        ch=$(DLG --no-ok --cancel-label "Back" --title "Selkies (WebSocket :8080)" \
            --menu "Login: $(selkies_get_user)   Resolution: $(desktop_get_res)" 15 64 4 \
            systemctl  "Manage service (systemctl)" \
            user       "Change login (basic-auth)" \
            password   "Change password (basic-auth)" \
            resolution "Change resolution (restarts desktop)") || return
        case $ch in
            systemctl)  systemctl_menu "$SELKIES_UNIT" ;;
            user)       selkies_change_user ;;
            password)   selkies_change_pass ;;
            resolution) desktop_change_res ;;
        esac
    done
}

# ---- selkies: stream resolution ----
#
# Lives under the selkies menu because that is what the user is configuring, but
# it is physically the Xvfb -screen geometry in start-desktop.sh: xfce-session
# owns the display, selkies only attaches to it. Hence the desktop restart.
#
# This is the CEILING, not the working resolution: Selkies runs with
# enable_resize=true and scales DOWN to the client's window. Xvfb fixes its RANDR
# 'maximum' from the initial -screen geometry and cannot grow it at runtime, so a
# client asking for more than this gets a scaled image. Cost of a higher ceiling
# is RAM only (W*H*4 bytes) - it does not raise bitrate or CPU at smaller windows.

desktop_get_res() { grep -oP "(?<=^RES=')[^']+" "$DESKTOP_WRAPPER" 2>/dev/null | head -1; }

desktop_change_res() {
    local cur new
    cur=$(desktop_get_res)
    new=$(DLG --no-ok --cancel-label "Back" --title "Framebuffer ceiling" \
        --menu "Current: ${cur:-unknown}\n\nSelkies scales DOWN to the client window;\nthis only caps how large it may get." 16 64 3 \
        1920x1080 "Full HD        (~8 MB RAM)" \
        2560x1440 "QHD / HiDPI    (~14 MB RAM)" \
        3840x2160 "4K UHD         (~33 MB RAM)") || return

    [ "$new" = "$cur" ] && { DLG --title "Resolution" --msgbox "Already set to ${new}.\nNothing to do." 8 50; return; }

    # Restarting Xvfb means tearing down the X server every client is attached to.
    # start-desktop.sh also wipes ~/.config/xfce4 on each start by design, so this
    # is genuinely destructive - make that explicit before doing it.
    DLG --title "Restart desktop?" --defaultno --yesno \
"Change framebuffer ceiling ${cur:-?} -> ${new}?\n\nThis RESTARTS the desktop session:\n  - all open windows are lost\n  - XFCE settings are reset (start-desktop.sh\n    wipes ~/.config/xfce4 on every start)\n  - connected Selkies / VNC clients drop and\n    must reconnect\n\nProceed?" 16 64 || return

    sed -i "s/^RES='[^']*'/RES='${new}'/" "$DESKTOP_WRAPPER" \
        || { DLG --title "Error" --msgbox "Failed to write $DESKTOP_WRAPPER" 9 60; return; }

    if [ "$(desktop_get_res)" != "$new" ]; then
        DLG --title "Error" --msgbox "Could not update RES= in\n$DESKTOP_WRAPPER\n\nThe file may have an unexpected format." 10 60
        return
    fi

    # xfce-session owns the display; selkies/x11vnc only attach to it. They use
    # Requires= (not PartOf=), so systemd does NOT restart them automatically -
    # without this they would keep pointing at a dead :99.
    run_show "restart desktop stack" systemctl restart "$DESKTOP_UNIT" "$SELKIES_UNIT" "$VNC_UNIT"
    DLG --title "Resolution" --msgbox "Framebuffer ceiling is now ${new}.\n\nReconnect your Selkies / VNC client." 9 60
}

# ---- vnc: password management (classic x11vnc, no login) ----

vnc_change_pass() {
    local new
    new=$(DLG --cancel-label "Back" --insecure --title "VNC password" --passwordbox "New VNC password (max 8 chars):" 9 60) || return
    [ -n "$new" ] || { DLG --title "Error" --msgbox "Password cannot be empty." 8 50; return; }
    mkdir -p "$(dirname "$VNC_PASSWD")"
    if x11vnc -storepasswd "$new" "$VNC_PASSWD" >/dev/null 2>&1; then
        run_show "restart $VNC_UNIT" systemctl restart "$VNC_UNIT"
        DLG --title "VNC password" --msgbox "VNC password changed.\nService restarted.\n(VNC truncates the password to 8 chars.)" 10 60
    else
        DLG --title "Error" --msgbox "x11vnc -storepasswd failed." 8 56
    fi
}

vnc_menu() {
    local ch
    while true; do
        ch=$(DLG --no-ok --cancel-label "Back" --title "VNC (x11vnc :5900)" --menu "Action:" 12 60 2 \
            systemctl "Manage service (systemctl)" \
            password  "Change VNC password") || return
        case $ch in
            systemctl) systemctl_menu "$VNC_UNIT" ;;
            password)  vnc_change_pass ;;
        esac
    done
}

# ---- main ----
[ "$(id -u)" -eq 0 ] || die "run as root"
command -v dialog >/dev/null 2>&1 || die "dialog not found (apt-get install dialog)"

# Main menu keeps its buttons: "Select" activates the highlighted entry, "Exit"
# leaves. Submenus stay --no-ok / "Back" as before.
while true; do
    CH=$(DLG --ok-label "Select" --cancel-label "Exit" --title "deskui" --menu "Select a service:" 12 60 2 \
        selkies "Selkies WebSocket (web :8080)" \
        vnc     "VNC (x11vnc :5900)") || exit 0
    case $CH in
        selkies) selkies_menu ;;
        vnc)     vnc_menu ;;
    esac
done
